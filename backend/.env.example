# ============================================
# Gmail Manager - Environment Configuration
# Version: 1.1.0
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL connection string (Production/Test)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# SQLite database path (Development only)
SQLITE_DB_PATH=gmail_manager.db

# Connection pool size (10 dev/test, 20-50 production)
DB_POOL_SIZE=10

# Connection timeout in seconds (1.5 test, 30 production)
DB_POOL_TIMEOUT=1.5

# ============================================
# ENCRYPTION & SECURITY
# ============================================

# Fernet encryption key for OAuth tokens (32 bytes, base64)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=

# CSRF token signing key
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Legacy keys (replaced by SECRET_KEY and DB_ENCRYPTION_KEY)
JWT_SECRET_KEY=
SESSION_SECRET_KEY=

# ============================================
# GOOGLE OAUTH & GMAIL API
# ============================================

# Google OAuth 2.0 credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Google Safe Browsing API Key (optional, for URL scanning)
# Replace the placeholder before use.
GOOGLE_SAFE_BROWSING_KEY=your_key_here

# ============================================
# AI PROVIDERS
# ============================================

# Groq API Keys (Primary) - Get from https://console.groq.com/keys
# Supports 1-9 rotating keys for high throughput.
# Replace each placeholder before use.
GROQ_API_KEY=your_key_here
GROQ_API_KEY_1=your_key_here
GROQ_API_KEY_2=your_key_here
GROQ_API_KEY_3=your_key_here
GROQ_API_KEY_4=your_key_here
GROQ_API_KEY_5=your_key_here
GROQ_API_KEY_6=your_key_here
GROQ_API_KEY_7=your_key_here
GROQ_API_KEY_8=your_key_here
GROQ_API_KEY_9=your_key_here

# Google Gemini API Keys (Secondary) - Get from https://aistudio.google.com/
# Replace each placeholder before use.
GEMINI_API_KEY=your_key_here
GEMINI_API_KEY_1=your_key_here
GEMINI_API_KEY_2=your_key_here
GEMINI_API_KEY_3=your_key_here
GEMINI_API_KEY_4=your_key_here
GEMINI_API_KEY_5=your_key_here
GEMINI_API_KEY_6=your_key_here
GEMINI_API_KEY_7=your_key_here
GEMINI_API_KEY_8=your_key_here
GEMINI_API_KEY_9=your_key_here
GEMINI_API_KEY_10=your_key_here
GEMINI_API_KEY_11=your_key_here
GEMINI_API_KEY_12=your_key_here
GEMINI_API_KEY_13=your_key_here
GEMINI_API_KEY_14=your_key_here
GEMINI_API_KEY_15=your_key_here
GEMINI_API_KEY_16=your_key_here
GEMINI_API_KEY_17=your_key_here

# Cohere API Key (Tertiary) - Get from https://dashboard.cohere.ai/
COHERE_API_KEY=your_key_here

# Cloudflare Workers AI (Quaternary) - Get from https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here
CLOUDFLARE_MODEL=@cf/zai-org/glm-4.7-flash

# ============================================
# ML MODEL CONFIGURATION
# ============================================

# Scam detection threshold (0.0-1.0, higher = fewer false positives)
ML_CONFIDENCE_THRESHOLD=0.85

# Audit sample rate (0.0-1.0, percentage to audit for improvement)
ML_AUDIT_SAMPLE_RATE=0.04

# Minimum recall for high-risk emails (ensures critical scams caught)
ML_MIN_RECALL_HIGH_RISK=0.25

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Environment (development, test, production)
ENVIRONMENT=development

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# Enable background scheduler for periodic tasks
ENABLE_SCHEDULER=true

# API rate limit (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# Frontend URL for CORS
FRONTEND_URL=https://gmailman.vercel.app

# Allowed CORS origin (must match FRONTEND_URL)
ALLOWED_ORIGIN=https://gmailman.vercel.app

# ============================================
# NOTES
# ============================================

# 1. Copy this file: cp .env.example .env
# 2. Generate keys with commands shown above
# 3. Get API keys from provider dashboards
# 4. NEVER commit real keys to version control
# 5. Use different keys for dev/test/prod
# 6. See docs/deployment.md for full setup guide

# ---------- Phase 2: AI cascade (all optional; defaults shown) ----------
# Comma-separated provider order. Only configured providers are attempted.
AI_PROVIDER_ORDER=groq,gemini,cohere,ovh
# Per-provider request timeout (seconds).
AI_PROVIDER_TIMEOUT=12
# Overall per-email AI deadline across the whole cascade (seconds).
AI_DEADLINE=30
# Circuit-breaker cooldown when a provider fails without a Retry-After hint.
AI_BREAKER_COOLDOWN=45
AI_BREAKER_MIN_COOLDOWN=30
AI_BREAKER_MAX_COOLDOWN=60
# Maximum seconds to honour an explicit Retry-After (ceiling to prevent one
# pathological provider response from disabling it for the entire run).
AI_BREAKER_MAX_RETRY_AFTER=300
# Email-analysis concurrency (replaces the old hard-coded 2).
ANALYZE_CONCURRENCY=3
# Optional providers stay off unless explicitly enabled.
# NVIDIA is disabled unless NVIDIA_MODEL is also set (previous default model retired).
NVIDIA_MODEL=
ENABLE_KILO=false
ENABLE_LLM7=false

# ============================================
# PERFORMANCE & BATCHING (perf/batching)
# ============================================
# Batch Gmail label sync with users.messages.batchModify (1 = enabled, 0 = per-email)
SYNC_BATCH=1

# Batch fetch email bodies via Gmail BatchHttpRequest (1 = enabled, 0 = per-email)
FETCH_BATCH=1
FETCH_BATCH_SIZE=25
FETCH_BATCH_PARALLEL=2

# Batch AI classifications in single prompt calls (1 = OFF; recommend 5 after verification)
AI_BATCH_SIZE=1
AI_BATCH_WAIT_MS=400
AI_BATCH_BODY_CHARS=1500

# Overlap URL scanning and AI cascade concurrently (1 = enabled, 0 = sequential)
URL_AI_OVERLAP=0

# Batched DB result writes via queue worker and UPDATE ... FROM (VALUES ...) (1 = enabled, 0 = single)
DB_BATCH_WRITES=0

# Sizing recommendations (do not apply without sizing environment):
# ANALYZE_CONCURRENCY=6
# DB_POOL_MAX=10 (keeps pool at least 2 above concurrency and under Supabase's session cap of 15)

