# Docker Compose Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE
# ============================================
POSTGRES_PASSWORD=changeme_secure_password
DATABASE_URL=postgresql://postgres:changeme_secure_password@postgres:5432/gmail_manager

# ============================================
# SECURITY & ENCRYPTION
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_ENCRYPTION_KEY=your_encryption_key_here_32_bytes_min
JWT_SECRET_KEY=your_jwt_secret_key_here_32_bytes_min

# ============================================
# GOOGLE OAUTH
# ============================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# ============================================
# AI PROVIDERS (at least one required)
# ============================================
# Groq (recommended, fast inference)
GROQ_API_KEY=gsk_your_groq_api_key

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Cohere (optional)
COHERE_API_KEY=

# NVIDIA (optional)
NVIDIA_API_KEY=

# OpenRouter (optional)
OPENROUTER_API_KEY=

# ============================================
# SECURITY SERVICES
# ============================================
# Google Safe Browsing API
# Get from: https://console.cloud.google.com/apis/credentials
SAFE_BROWSING_API_KEY=your_safe_browsing_api_key

# ============================================
# REDIS (optional, for caching)
# ============================================
REDIS_URL=

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=development

# ============================================
# FRONTEND
# ============================================
VITE_API_BASE=http://localhost:8000
