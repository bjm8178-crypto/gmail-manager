# Gmail Manager Environment Variables
# Rename this file to .env (and make sure .env is in .gitignore)

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-local-secret
GOOGLE_REDIRECT_URI=https://gmail-manager-production-8896.up.railway.app/auth/callback

# Session / Security Secrets
SESSION_SECRET_KEY=replace-with-local-secret
JWT_SECRET_KEY=replace-with-local-secret
DB_ENCRYPTION_KEY=replace-with-local-secret

# Groq API Keys
