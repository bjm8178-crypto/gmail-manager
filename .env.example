# Database Configuration
# Railway's internal URL only works inside Railway, so it is commented out here.
# On Railway this is already set in the dashboard. Locally, SQLite is used.
# DATABASE_URL=postgresql://postgres:HCLrheinGweeVFVlxjRdvMrJCcXrvQft@postgres.railway.internal:5432/railway

# Deployment Configuration
ALLOWED_ORIGIN=https://gmailman.vercel.app
FRONTEND_URL=https://gmailman.vercel.app

# Force SQLite (local development only; keep false/unset on Railway)
FORCE_SQLITE=false